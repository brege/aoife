; supply-chain hardening: block install scripts, pin exact, cool down
; freshly published releases, forbid external specs, fail audits at moderate+
ignore-scripts=true
strict-allow-scripts=true
save-exact=true
min-release-age=7
; brace-expansion 5.0.8 is the sole fix for GHSA-mh99-v99m-4gvg (high,
; affects <=5.0.7); no version passes both the age gate and the audit
min-release-age-exclude=brace-expansion
allow-directory=none
allow-file=none
allow-git=none
allow-remote=none
audit-level=moderate
