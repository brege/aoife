{
  "name": "aoife",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "biome check --write",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-warnings=ExperimentalWarning,--no-warnings=DEP0180 start-server-and-test dev http://localhost:5173 mocha",
    "test:integration": "NODE_OPTIONS=--no-warnings=ExperimentalWarning,--no-warnings=DEP0180 start-server-and-test dev http://localhost:5173 \"mocha --group integration\"",
    "test:e2e": "NODE_OPTIONS=--no-warnings=ExperimentalWarning,--no-warnings=DEP0180 start-server-and-test dev http://localhost:5173 \"mocha --group e2e\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@tanstack/react-query": "^5.101.4",
    "@types/ws": "^8.18.1",
    "@use-gesture/react": "^10.3.1",
    "axios": "^1.18.1",
    "embla-carousel": "^8.1.6",
    "embla-carousel-react": "^8.1.6",
    "framer-motion": "^12.42.2",
    "pino": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
    "ws": "^8.21.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "baseline-browser-mapping": "^2.11.4",
    "chai": "^4.5.0",
    "cypress": "^14.5.4",
    "js-yaml": "^4.3.0",
    "mocha": "^11.7.6",
    "puppeteer": "^24.43.1",
    "start-server-and-test": "^2.1.5",
    "typescript": "~5.9.3",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "cypress@14.5.4": true,
    "esbuild@0.25.12": true,
    "puppeteer@24.43.1": true
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.3",
      "glob": "13.0.6",
      "minimatch": "10.2.4",
      "serialize-javascript": "7.0.7"
    },
    "cypress": {
      "qs": "6.15.3",
      "uuid": "11.1.1"
    },
    "undici": "7.28.0",
    "ws": "$ws"
  }
}
